# CloudOptima Environment Configuration

# Database (Default: local SQLite; or PostgreSQL)
DATABASE_URL=sqlite:///./cloudoptima.db
# DATABASE_URL=postgresql://cloudoptima:cloudoptima_secure_password@localhost:5432/cloudoptima

# Security
SECRET_KEY=super-secret-cloudoptima-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operation Modes
DEMO_MODE=true
AUTO_REMEDIATE_LOW_RISK_DEFAULT=false

# Scanner Schedule (Minutes)
SCAN_INTERVAL_MINUTES=180

# Cloud Credentials (Optional - Mock simulator active by default)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GOOGLE_APPLICATION_CREDENTIALS=
